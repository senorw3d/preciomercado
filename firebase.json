{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "node_modules/**",
      "scratch/**",
      "historico_data/**",
      "**/*.py",
      "**/*.pyc",
      "**/__pycache__/**",
      "**/*.ps1"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
